# `npm run setup docker` or `bash scripts/create-db.sh` writes .env for you. Never commit .env.
DATABASE_URL=postgres://sidequest:change-me@localhost:5432/sidequest
DASHBOARD_PORT=4321

# Docker only (written by npm run setup docker):
# SIDEQUEST_DB_PASSWORD=
# SIDEQUEST_DB_PORT=5433

# Optional: report summaries use the Claude Code CLI.
# SIDEQUEST_CLAUDE_BIN=claude
# SIDEQUEST_SUMMARY_MODEL=sonnet
